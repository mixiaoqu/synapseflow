# Compose ports bound to localhost on the server.
# 1Panel reverse proxy should forward public traffic to these ports.
SF_FRONTEND_PORT=3000
SF_BACKEND_PORT=8000

# PostgreSQL
POSTGRES_USER=synapseflow
POSTGRES_PASSWORD=change-this-db-password
POSTGRES_DB=synapseflow

# Backend runtime
SF_ENV=production
SF_DEBUG=false
SF_BACKEND_WORKERS=4
SF_DRAMATIQ_PROCESSES=2
SF_DRAMATIQ_THREADS=2
SF_DRAMATIQ_INDEXING_QUEUE=indexing
SF_SECRET_KEY=change-this-to-a-long-random-string
SF_CORS_ORIGINS=https://app.example.com,https://api.example.com
SF_EMBEDDING_MODEL=

# Frontend public API URL
SF_NEXT_PUBLIC_API_URL=https://api.example.com

# Optional package mirror for backend image builds
SF_UV_INDEX_URL=https://pypi.org/simple

# Model provider keys
DEEPSEEK_API_KEY=
KIMI_API_KEY=
SILICONFLOW_API_KEY=
MODELSCOPE_API_KEY=
AIHUBMIX_API_KEY=
OPENROUTER_API_KEY=
DASHSCOPE_API_KEY=
MOYU_API_KEY=

# Optional rerank service
SF_RERANK_ENABLED=true
SF_RERANK_API_URL=http://localhost:8012
SF_RERANK_API_KEY=

# Optional LangSmith tracing
SF_LANGSMITH_TRACING=false
SF_LANGSMITH_API_KEY=
SF_LANGSMITH_PROJECT=
SF_LANGSMITH_WORKSPACE_ID=

# Optional logging
SF_LOG_LEVEL=INFO
SF_LOG_JSON=false

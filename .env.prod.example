# Compose ports bound to localhost on the server.
# Set SF_BIND_HOST=0.0.0.0 if you want direct public access via server IP + port.
SF_BIND_HOST=127.0.0.1
SF_FRONTEND_PORT=3000
SF_BACKEND_PORT=8000
SF_NGINX_BIND_HOST=0.0.0.0
SF_NGINX_PORT=80
SF_NGINX_SERVER_NAME=_
SF_CLIENT_MAX_BODY_SIZE=50m

# PostgreSQL
POSTGRES_USER=synapseflow
POSTGRES_PASSWORD=change-this-db-password
POSTGRES_DB=synapseflow

# Backend runtime
SF_ENV=production
SF_DEBUG=false
SF_BACKEND_WORKERS=4
SF_DRAMATIQ_PROCESSES=2
SF_DRAMATIQ_THREADS=2
SF_DRAMATIQ_INDEXING_QUEUE=indexing
SF_SECRET_KEY=change-this-to-a-long-random-string
SF_CORS_ORIGINS=https://app.example.com
SF_EMBEDDING_MODEL=BAAI/bge-m3
HF_ENDPOINT=https://hf-mirror.com

# Frontend public API URL.
# Recommended: leave this empty when nginx is the only public entrypoint, so the
# frontend uses the current domain and /api reverse proxy automatically.
# Only set it when the frontend must call a different external API origin.
SF_NEXT_PUBLIC_API_URL=

# Optional package mirrors for domestic servers
SF_UV_INDEX_URL=https://mirrors.aliyun.com/pypi/simple
SF_NPM_REGISTRY=https://registry.npmmirror.com

# Model provider keys
DEEPSEEK_API_KEY=
KIMI_API_KEY=
SILICONFLOW_API_KEY=
MODELSCOPE_API_KEY=
AIHUBMIX_API_KEY=
OPENROUTER_API_KEY=
DASHSCOPE_API_KEY=
MOYU_API_KEY=

# Bootstrap users created during init_db.py
BOOTSTRAP_ENABLED=true
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@synapseflow.local
BOOTSTRAP_ADMIN_PASSWORD=change-this-admin-password
BOOTSTRAP_USER_USERNAME=user
BOOTSTRAP_USER_EMAIL=user@synapseflow.local
BOOTSTRAP_USER_PASSWORD=change-this-user-password

# Optional rerank config.
# The production compose file includes a local BGE reranker service by default.
SF_RERANK_ENABLED=true
SF_RERANK_PROVIDER=vllm
SF_RERANK_MODEL=BAAI/bge-reranker-v2-m3
SF_RERANK_USE_FP16=false
SF_RERANK_TOP_K=
SF_RERANK_API_URL=http://reranker:8012
SF_RERANK_API_KEY=

# Optional LangSmith tracing
SF_LANGSMITH_TRACING=false
SF_LANGSMITH_API_KEY=
SF_LANGSMITH_PROJECT=
SF_LANGSMITH_WORKSPACE_ID=

# Optional logging
SF_LOG_LEVEL=INFO
SF_LOG_JSON=false

# SynapseFlow 生产环境变量示例
# 用法：docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build
# 说明：
# 1. 复制本文件为 `.env.prod` 后，再按实际环境填写。
# 2. 当前文件只保留 `docker-compose.prod.yml` 会实际读取并传入容器的配置项。
# 3. 带密码、密钥、令牌的项必须替换，不能直接使用示例值。

# =============================================================================
# 一、对外入口与端口绑定
# =============================================================================
# 生产容器入口只监听本机，由宿主机 nginx 统一承接公网 80/443。
SF_NGINX_BIND_HOST=127.0.0.1
# 宿主机 nginx 将生产域名转发到此端口；测试环境使用 18080。
SF_NGINX_PORT=18081
# 生产容器入口接受的域名。
SF_NGINX_SERVER_NAME=zsk.szsayu.com
# 上传体积限制。
SF_CLIENT_MAX_BODY_SIZE=50m

# 业务容器在宿主机上的绑定地址。生产建议保持 127.0.0.1，只让 nginx 访问。
SF_BIND_HOST=127.0.0.1
# 前端容器映射到宿主机的端口。
SF_FRONTEND_PORT=5173
# 后端容器映射到宿主机的端口。
SF_BACKEND_PORT=8000
# Neo4j HTTP 管理端口。
SF_NEO4J_HTTP_PORT=7474
# Neo4j Bolt 连接端口。
SF_NEO4J_BOLT_PORT=7687

# =============================================================================
# 二、公网访问相关
# =============================================================================
# 后端 CORS 白名单，多个值用英文逗号分隔。
# 嵌入页、分享页、回跳链接统一使用的正式公网入口。
SF_EMBED_FRONTEND_BASE_URL=https://zsk.szsayu.com

# 前端构建时写入的 API 基础路径。默认走 nginx 同域名反代。
SF_FRONTEND_API_BASE_URL=/api/v1
# 前端请求超时时间（毫秒）。
SF_FRONTEND_API_TIMEOUT_MS=15000

# =============================================================================
# 三、数据库与缓存
# =============================================================================
# PostgreSQL 用户名。
POSTGRES_USER=synapseflow
# PostgreSQL 密码，必须替换。
POSTGRES_PASSWORD=change-this-db-password
# PostgreSQL 数据库名。
POSTGRES_DB=synapseflow

# Neo4j 容器密码，必须替换。
NEO4J_PASSWORD=change-this-neo4j-password

# =============================================================================
# 四、后端基础运行
# =============================================================================
# 运行环境标识。
SF_ENV=production
# 是否开启调试模式。生产通常保持 false。
SF_DEBUG=false
# JWT / 签名密钥，必须替换为长随机字符串。
SF_SECRET_KEY=change-this-to-a-long-random-string
# 是否允许公开注册。
ENABLE_PUBLIC_REGISTRATION=false
# 企业嵌入接口鉴权令牌，必须替换为长随机字符串。
SF_ENTERPRISE_SERVICE_TOKEN=change-this-to-a-long-random-string
SF_INTEGRATION_CREDENTIAL_PEPPER=change-this-to-a-different-long-random-string
# 嵌入会话 token 过期时间（分钟）。
SF_EMBED_TOKEN_EXPIRE_MINUTES=60
# Agent Widget 短期 token 过期时间（分钟）。
SF_WIDGET_TOKEN_EXPIRE_MINUTES=15
# 业务 Bootstrap 返回给 Widget 的正式 API 地址。
SF_AGENT_PUBLIC_API_BASE_URL=https://zsk.szsayu.com/api/v1
# 上传大小限制（字节）。
SF_MAX_UPLOAD_SIZE=10485760

# =============================================================================
# 五、首次初始化管理员
# =============================================================================
# 仅首次部署时改为 true，管理员创建完成后建议改回 false。
BOOTSTRAP_ENABLED=false
# 初始化管理员用户名。
BOOTSTRAP_ADMIN_USERNAME=admin
# 初始化管理员邮箱。
BOOTSTRAP_ADMIN_EMAIL=admin@synapseflow.local
# 初始化管理员密码。必须替换为强密码，且长度至少 12 位。
BOOTSTRAP_ADMIN_PASSWORD=change-this-to-a-long-random-admin-password
# 初始化管理员显示名。
BOOTSTRAP_ADMIN_FULL_NAME=System Administrator

# =============================================================================
# 六、进程、线程与队列
# =============================================================================
# 后端 Web 进程数。
SF_BACKEND_WORKERS=4

# 文档索引队列名。
SF_DRAMATIQ_INDEXING_QUEUE=indexing
# 图谱索引队列名。
SF_DRAMATIQ_GRAPH_INDEXING_QUEUE=graph_indexing
# 评测队列名。
SF_DRAMATIQ_EVALUATION_QUEUE=evaluation

# 文档索引 worker 进程数。
SF_DRAMATIQ_INDEXING_PROCESSES=1
# 文档索引 worker 线程数。
SF_DRAMATIQ_INDEXING_THREADS=2

# 图谱索引 worker 进程数。
SF_DRAMATIQ_GRAPH_PROCESSES=1
# 图谱索引 worker 线程数。
SF_DRAMATIQ_GRAPH_THREADS=1

# 评测 worker 进程数。
SF_DRAMATIQ_EVALUATION_PROCESSES=1
# 评测 worker 线程数。
SF_DRAMATIQ_EVALUATION_THREADS=1

# =============================================================================
# 七、模型服务密钥
# =============================================================================
# 当前生产编排会直接校验以下三项是否存在。
SILICONFLOW_API_KEY=
MOYU_API_KEY=
DEEPSEEK_API_KEY=

# =============================================================================
# 八、Embedding 配置
# =============================================================================
# 向量模型提供方。
SF_EMBEDDING_PROVIDER=siliconflow
# 向量接口地址。
SF_EMBEDDING_API_URL=https://api.siliconflow.cn/v1/embeddings
# 向量模型名称。
SF_EMBEDDING_MODEL=BAAI/bge-m3
# 留空表示使用服务端默认维度。
SF_EMBEDDING_DIMENSIONS=

# =============================================================================
# 九、Rerank 配置
# =============================================================================
# 是否启用重排。
SF_RERANK_ENABLED=true
# 重排服务提供方。
SF_RERANK_PROVIDER=siliconflow
# 重排模型名称。
SF_RERANK_MODEL=BAAI/bge-reranker-v2-m3
# 重排接口地址。
SF_RERANK_API_URL=https://api.siliconflow.cn/v1/rerank
# 留空表示使用后端配置文件中的默认 top_k。
SF_RERANK_TOP_K=

# =============================================================================
# 十、图谱 / Neo4j 配置
# =============================================================================
# 是否启用图谱检索。
GRAPH_ENABLED=false
# 是否启用图谱索引。
GRAPH_INDEXING_ENABLED=false
# 图谱连接地址。
GRAPH_URI=bolt://neo4j:7687
# 图谱用户名。
GRAPH_USERNAME=neo4j
# 图谱密码。通常与 NEO4J_PASSWORD 保持一致。
GRAPH_PASSWORD=change-this-neo4j-password
# 图谱数据库名。
GRAPH_DATABASE=neo4j

# 说明：
# 1. 当前生产 docker 里，图谱索引 worker 的进程数 / 线程数由
#    `SF_DRAMATIQ_GRAPH_PROCESSES` 和 `SF_DRAMATIQ_GRAPH_THREADS` 控制。
# 2. 图谱抽取内部并发（如 extraction_concurrency）当前不走 env，
#    需要到 `backend/config/app.yaml` 的 `graph` 段修改。

# =============================================================================
# 十一、对象存储（OSS）
# =============================================================================
# 是否启用对象存储直传。
SF_OSS_ENABLED=false
# 对象存储提供方。当前默认值为 aliyun_oss。
SF_OSS_PROVIDER=aliyun_oss
# Bucket 名称。
SF_OSS_BUCKET=
# OSS 内网或服务端访问端点。
SF_OSS_ENDPOINT=
# 前端或外链使用的公开访问端点。
SF_OSS_PUBLIC_ENDPOINT=
# Access Key ID。
SF_OSS_ACCESS_KEY_ID=
# Access Key Secret。
SF_OSS_ACCESS_KEY_SECRET=
# 直传签名过期时间（秒）。
SF_OSS_UPLOAD_EXPIRE_SECONDS=900

# =============================================================================
# 十二、可观测性与日志
# =============================================================================
# 是否启用 LangSmith tracing。
SF_LANGSMITH_TRACING=false
# LangSmith API Key。
SF_LANGSMITH_API_KEY=
# LangSmith 项目名。
SF_LANGSMITH_PROJECT=
# LangSmith Workspace ID。
SF_LANGSMITH_WORKSPACE_ID=

# 日志级别。
SF_LOG_LEVEL=INFO
# 是否输出 JSON 日志。
SF_LOG_JSON=false

# =============================================================================
# 十三、构建镜像与模型下载镜像源
# =============================================================================
# Python 依赖安装镜像源。
SF_UV_INDEX_URL=https://mirrors.aliyun.com/pypi/simple
# PyTorch CPU 轮子下载源。
SF_PYTORCH_CPU_FIND_LINKS=https://mirrors.aliyun.com/pytorch-wheels/cpu/
# Node 依赖安装镜像源。
SF_NPM_REGISTRY=https://registry.npmmirror.com
# HuggingFace 镜像地址。
HF_ENDPOINT=https://hf-mirror.com

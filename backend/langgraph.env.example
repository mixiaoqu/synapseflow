# LangGraph Studio env - ASCII only (avoids Windows GBK decode error)
# Copy to langgraph.env and fill in from .env. Do NOT add Chinese or non-ASCII.

DATABASE_URL=postgresql+asyncpg://synapseflow:password@localhost:5432/synapseflow
REDIS_URL=redis://localhost:6379/0
DRAMATIQ_INDEXING_QUEUE=indexing
EMBEDDING_MODEL=
DEEPSEEK_API_KEY=
KIMI_API_KEY=
DASHSCOPE_API_KEY=
LANGSMITH_API_KEY=

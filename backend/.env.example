# ============================================
# LLM API密钥配置
# ============================================
# 密钥变量名需与 config/models.yaml 中的 api_key_env 一致

# Deepseek（供 fast 模型使用）
DEEPSEEK_API_KEY=sk-your-deepseek-key

# Kimi/Moonshot（供 smart 模型使用）
KIMI_API_KEY=sk-your-kimi-key

# SiliconFlow（多模型代理平台）
SILICONFLOW_API_KEY=sk-your-siliconflow-key

# ModelScope（阿里云模型平台）
MODELSCOPE_API_KEY=ms-your-modelscope-key

# ============================================
# 数据库配置
# ============================================
DATABASE_URL=postgresql+asyncpg://synapseflow:your_password@localhost:5432/synapseflow
POSTGRES_USER=synapseflow
POSTGRES_PASSWORD=your_password
POSTGRES_DB=synapseflow

# ============================================
# 安全配置
# ============================================
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ============================================
# 应用配置
# ============================================
PROJECT_NAME=SynapseFlow
VERSION=0.1.0
API_V1_STR=/api/v1
DEBUG=True

# ============================================
# CORS配置
# ============================================
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ============================================
# 文件存储配置
# ============================================
PREVIEW_DIR=./workspace/previews
UPLOAD_DIR=./workspace/uploads
MAX_UPLOAD_SIZE=10485760

# ============================================
# 向量数据库配置（本地 BGE 中文嵌入）
# ============================================
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
VECTOR_DIMENSION=512

# ============================================
# LLM模型配置文件路径
# ============================================
MODELS_CONFIG_PATH=config/models.yaml

# ============================================
# LangSmith 可观测性（可选）
# ============================================
# 设为 true 启用追踪
LANGSMITH_TRACING=true
# 在 smith.langchain.com 创建的 API Key
LANGSMITH_API_KEY=lsv2_pt_xxx
# 可选：指定项目名，不设则使用默认 project
LANGSMITH_PROJECT=synapseflow-dev
# 可选：多工作区时指定
# LANGSMITH_WORKSPACE_ID=xxx

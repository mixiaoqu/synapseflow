# ============================================
# LLM API密钥配置
# ============================================
# 密钥变量名需与 config/models.yaml 中的 api_key_env 一致

# 墨鱼（OpenAI 兼容，https://www.moyu.info/v1 ，与 models.yaml 中 provider moyu 对应）
MOYU_API_KEY=sk-your-moyu-key

# ============================================
# 数据库配置
# ============================================
DATABASE_URL=postgresql+asyncpg://synapseflow:your_password@localhost:5432/synapseflow
POSTGRES_USER=synapseflow
POSTGRES_PASSWORD=your_password
POSTGRES_DB=synapseflow

# ============================================
# 安全配置
# ============================================
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ENTERPRISE_SERVICE_TOKEN=your-enterprise-service-token-change-this
EMBED_TOKEN_EXPIRE_MINUTES=30
EMBED_FRONTEND_BASE_URL=http://localhost:5174

# ============================================
# 应用配置
# ============================================
PROJECT_NAME=SynapseFlow
VERSION=0.1.0
API_V1_STR=/api/v1
DEBUG=True

# ============================================
# CORS配置
# ============================================
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174,http://localhost:3000,http://127.0.0.1:3000

# ============================================
# 文件存储配置
# ============================================
PREVIEW_DIR=./workspace/previews
UPLOAD_DIR=./workspace/uploads
MAX_UPLOAD_SIZE=10485760

# ============================================
# 向量数据库配置（默认与 config/embedding.yaml：bge-m3、1024 维）
# ============================================
EMBEDDING_MODEL=BAAI/bge-m3
VECTOR_DIMENSION=1024

# ============================================
# Rerank（可选，与向量召回配合）
# ============================================
# Docker Compose 默认启动本地 BGE reranker 服务，backend 容器内使用 http://reranker:8012。
# 非 Docker 本地运行时，如 reranker 暴露在宿主机 8012，可改成 http://localhost:8012。
RERANK_ENABLED=true
RERANK_PROVIDER=local
RERANK_API_URL=http://reranker:8012
RERANK_API_KEY=
RERANK_MODEL=BAAI/bge-reranker-v2-m3
# 片段条数：config/embedding.yaml → retrieval.final_top_k

# ============================================
# LLM模型配置文件路径
# ============================================
MODELS_CONFIG_PATH=config/models.yaml

# ============================================
# LangSmith 可观测性（可选）
# ============================================
# 设为 true 启用追踪
LANGSMITH_TRACING=true
# 在 smith.langchain.com 创建的 API Key
LANGSMITH_API_KEY=lsv2_pt_xxx
# 可选：指定项目名，不设则使用默认 project
LANGSMITH_PROJECT=synapseflow-dev
# 可选：多工作区时指定
# LANGSMITH_WORKSPACE_ID=xxx

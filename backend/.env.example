# ============================================
# LLM API密钥配置
# ============================================
# 密钥变量名需与 config/models.yaml 中的 api_key_env 一致
# models.yaml 的 system_roles 默认使用 deepseek-v4-flash（provider: deepseek），
# 因此本地开发至少需要配置 DEEPSEEK_API_KEY。

# DeepSeek（默认问答 LLM，对应 models.yaml system_roles）
DEEPSEEK_API_KEY=sk-your-deepseek-key
# SiliconFlow（embedding 在线调用 + 可选 LLM；models.yaml 中 provider siliconflow）
SILICONFLOW_API_KEY=sk-your-siliconflow-key

# 全局联网能力：开启且配置 Key 后，所有 Agent 应用均可使用，无需逐应用授权。
WEB_SEARCH_ENABLED=false
TAVILY_API_KEY=


# ============================================
# 数据库配置
# ============================================
DATABASE_URL=postgresql+asyncpg://synapseflow:your_password@localhost:5432/synapseflow
POSTGRES_USER=synapseflow
POSTGRES_PASSWORD=your_password
POSTGRES_DB=synapseflow

# ============================================
# 安全配置
# ============================================
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ENTERPRISE_SERVICE_TOKEN=your-enterprise-service-token-change-this
INTEGRATION_CREDENTIAL_PEPPER=generate-a-long-random-integration-pepper
EMBED_TOKEN_EXPIRE_MINUTES=30
EMBED_FRONTEND_BASE_URL=http://localhost:5173
WIDGET_TOKEN_EXPIRE_MINUTES=15
AGENT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# ============================================
# 应用配置
# ============================================
PROJECT_NAME=LangChain RAG 知识库
VERSION=0.1.0
API_V1_STR=/api/v1
DEBUG=True

# ============================================
# CORS配置
# ============================================
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# ============================================
# 文件存储配置
# ============================================
PREVIEW_DIR=./workspace/previews
UPLOAD_DIR=./workspace/uploads
DOCUMENT_STAGING_DIR=./workspace/uploaded_documents/staging
MAX_UPLOAD_SIZE=10485760

# ============================================
# OSS 直传 / 私有读配置
# ============================================
# 当前仅支持阿里云 OSS。Bucket 建议保持私有读，浏览器通过后端签名直传。
OSS_ENABLED=true
OSS_PROVIDER=aliyun_oss
OSS_BUCKET=your-oss-bucket
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_PUBLIC_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
OSS_ACCESS_KEY_ID=your-oss-access-key-id
OSS_ACCESS_KEY_SECRET=your-oss-access-key-secret
OSS_UPLOAD_EXPIRE_SECONDS=900

# ============================================
# 图谱配置
# ============================================
GRAPH_ENABLED=false
GRAPH_INDEXING_ENABLED=false
GRAPH_URI=bolt://localhost:7687
GRAPH_USERNAME=neo4j
GRAPH_PASSWORD=
GRAPH_DATABASE=neo4j

# ============================================
# 向量数据库配置（默认与 config/embedding.yaml：bge-m3、1024 维）
# ============================================
# provider: local（本地 sentence-transformers，无需 Key）或 siliconflow（在线 API，需配 SILICONFLOW_API_KEY）
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-m3
VECTOR_DIMENSION=1024
# 在线 embedding 接口地址（provider 为 siliconflow 时使用，默认即可）
# EMBEDDING_API_URL=https://api.siliconflow.cn/v1/embeddings

# ============================================
# Rerank（统一走远程 SiliconFlow，不再运行本地 reranker）
# ============================================
# API Key 不填时复用上面的 SILICONFLOW_API_KEY。
RERANK_ENABLED=true
RERANK_PROVIDER=siliconflow
RERANK_API_URL=https://api.siliconflow.cn/v1/rerank
RERANK_API_KEY=
RERANK_MODEL=BAAI/bge-reranker-v2-m3
# 片段条数：config/embedding.yaml → retrieval.final_top_k

# ============================================
# LLM模型配置文件路径
# ============================================
MODELS_CONFIG_PATH=config/models.yaml

# ============================================
# LangSmith 可观测性（可选）
# ============================================
# 设为 true 启用追踪
LANGSMITH_TRACING=true
# 在 smith.langchain.com 创建的 API Key
LANGSMITH_API_KEY=lsv2_pt_xxx
# 可选：指定项目名，不设则使用默认 project
LANGSMITH_PROJECT=synapseflow-dev
# 可选：多工作区时指定
# LANGSMITH_WORKSPACE_ID=xxx

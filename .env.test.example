# SynapseFlow 同机测试环境变量模板
# 复制为 .env.test 后替换所有 change-this 与域名占位值。

# =============================================================================
# 一、测试栈入口与同机端口隔离
# =============================================================================
SF_TEST_NGINX_SERVER_NAME=zsk-test.szsayu.com
SF_TEST_NGINX_BIND_HOST=127.0.0.1
SF_TEST_NGINX_PORT=18080
SF_TEST_BIND_HOST=127.0.0.1
SF_TEST_FRONTEND_PORT=15173
SF_TEST_BACKEND_PORT=18000
SF_TEST_POSTGRES_PORT=15433
SF_TEST_REDIS_PORT=16380
SF_TEST_NEO4J_HTTP_PORT=17475
SF_TEST_NEO4J_BOLT_PORT=17688
SF_CLIENT_MAX_BODY_SIZE=50m

# =============================================================================
# 二、浏览器访问与 Agent 公网地址
# =============================================================================
# 必须包含测试平台域名，以及业务团队约定使用的本地开发 Origin。
SF_EMBED_FRONTEND_BASE_URL=https://zsk-test.szsayu.com
SF_AGENT_PUBLIC_API_BASE_URL=https://zsk-test.szsayu.com/api/v1
SF_FRONTEND_API_BASE_URL=/api/v1
SF_FRONTEND_API_TIMEOUT_MS=15000

# =============================================================================
# 三、测试数据库与缓存
# =============================================================================
POSTGRES_USER=synapseflow_test
POSTGRES_PASSWORD=change-this-test-db-password
POSTGRES_DB=synapseflow_test
NEO4J_PASSWORD=change-this-test-neo4j-password

# 供服务器外部诊断工具连接测试基础设施时使用，不会传入容器内部连接配置。
DATABASE_URL=postgresql+asyncpg://synapseflow_test:change-this-test-db-password@127.0.0.1:15433/synapseflow_test
REDIS_URL=redis://127.0.0.1:16380/0

# =============================================================================
# 四、后端安全与业务接入
# =============================================================================
SF_SECRET_KEY=change-this-to-a-long-random-test-secret
ENABLE_PUBLIC_REGISTRATION=false
SF_ENTERPRISE_SERVICE_TOKEN=change-this-to-a-long-random-test-service-token
SF_INTEGRATION_CREDENTIAL_PEPPER=change-this-to-a-different-long-random-test-pepper
SF_EMBED_TOKEN_EXPIRE_MINUTES=60
SF_WIDGET_TOKEN_EXPIRE_MINUTES=15
SF_MAX_UPLOAD_SIZE=10485760

# 首次部署时改为 true 并填写管理员信息；创建成功后改回 false。
BOOTSTRAP_ENABLED=true
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin-test@example.com
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_FULL_NAME=Test Administrator

# =============================================================================
# 五、Worker 与资源配置
# =============================================================================
SF_DRAMATIQ_INDEXING_QUEUE=indexing
SF_DRAMATIQ_GRAPH_INDEXING_QUEUE=graph_indexing
SF_DRAMATIQ_EVALUATION_QUEUE=evaluation
SF_DRAMATIQ_INDEXING_PROCESSES=1
SF_DRAMATIQ_INDEXING_THREADS=2
SF_DRAMATIQ_GRAPH_PROCESSES=1
SF_DRAMATIQ_GRAPH_THREADS=1

# =============================================================================
# 六、模型服务
# =============================================================================
SILICONFLOW_API_KEY=
MOYU_API_KEY=
DEEPSEEK_API_KEY=

SF_EMBEDDING_PROVIDER=siliconflow
SF_EMBEDDING_API_URL=https://api.siliconflow.cn/v1/embeddings
SF_EMBEDDING_MODEL=BAAI/bge-m3
SF_EMBEDDING_DIMENSIONS=

SF_RERANK_ENABLED=true
SF_RERANK_PROVIDER=siliconflow
SF_RERANK_MODEL=BAAI/bge-reranker-v2-m3
SF_RERANK_API_URL=https://api.siliconflow.cn/v1/rerank
SF_RERANK_TOP_K=

# =============================================================================
# 七、知识图谱
# =============================================================================
GRAPH_ENABLED=false
GRAPH_INDEXING_ENABLED=false
GRAPH_URI=bolt://neo4j-test:7687
GRAPH_USERNAME=neo4j
GRAPH_PASSWORD=change-this-test-neo4j-password
GRAPH_DATABASE=neo4j

# =============================================================================
# 八、日志和构建镜像源
# =============================================================================
SF_LOG_LEVEL=INFO
SF_LOG_JSON=false
SF_UV_INDEX_URL=https://mirrors.aliyun.com/pypi/simple
SF_PYTORCH_CPU_FIND_LINKS=https://mirrors.aliyun.com/pytorch-wheels/cpu/
SF_NPM_REGISTRY=https://registry.npmmirror.com
HF_ENDPOINT=https://hf-mirror.com

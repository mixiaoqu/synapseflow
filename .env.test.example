POSTGRES_USER=synapseflow_test
POSTGRES_PASSWORD=change-this-test-db-password
POSTGRES_DB=synapseflow_test

# docker-compose.test.yml 作为服务器测试库启动时建议显式传入：
# docker compose --env-file .env.test -f docker-compose.test.yml up -d
SF_TEST_BIND_HOST=127.0.0.1
SF_TEST_POSTGRES_PORT=5433
SF_TEST_REDIS_PORT=6380
SF_TEST_NEO4J_HTTP_PORT=7475
SF_TEST_NEO4J_BOLT_PORT=7688

# 本地或测试后端接入服务器测试库时使用这些连接串。
DATABASE_URL=postgresql+asyncpg://synapseflow_test:change-this-test-db-password@your-test-server-host:5433/synapseflow_test
REDIS_URL=redis://your-test-server-host:6380/0

# 知识图谱测试库。
NEO4J_PASSWORD=change-this-test-graph-password
GRAPH_ENABLED=true
GRAPH_INDEXING_ENABLED=true
GRAPH_URI=bolt://your-test-server-host:7688
GRAPH_USERNAME=neo4j
GRAPH_PASSWORD=change-this-test-graph-password
GRAPH_DATABASE=neo4j

# 宿主机唯一公网入口：按域名转发到彼此隔离的生产、测试 Docker nginx。
# 使用本模板前，生产 .env.prod 应绑定 127.0.0.1:18081，测试 .env.test 应绑定 127.0.0.1:18080。

map $http_upgrade $synapseflow_connection_upgrade {
    default upgrade;
    ''      "";
}

upstream synapseflow_prod {
    server 127.0.0.1:18081;
    keepalive 32;
}

upstream synapseflow_test {
    server 127.0.0.1:18080;
    keepalive 16;
}

server {
    listen 80;
    server_name zsk.szsayu.com zsk-test.szsayu.com;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name zsk.szsayu.com;

    ssl_certificate /etc/letsencrypt/live/zsk.szsayu.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/zsk.szsayu.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SynapseFlowProdTLS:10m;
    ssl_session_timeout 1d;

    client_max_body_size 50m;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $synapseflow_connection_upgrade;
    proxy_read_timeout 120s;
    proxy_send_timeout 120s;

    location ~ ^/api/v1/.*/stream {
        proxy_pass http://synapseflow_prod;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        add_header X-Accel-Buffering no always;
    }

    location = /mcp {
        proxy_pass http://synapseflow_prod;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        add_header X-Accel-Buffering no always;
    }

    location ^~ /mcp/ {
        proxy_pass http://synapseflow_prod;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        add_header X-Accel-Buffering no always;
    }

    location / {
        proxy_pass http://synapseflow_prod;
    }
}

server {
    listen 443 ssl http2;
    server_name zsk-test.szsayu.com;

    ssl_certificate /etc/letsencrypt/live/zsk-test.szsayu.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/zsk-test.szsayu.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SynapseFlowTestTLS:10m;
    ssl_session_timeout 1d;

    client_max_body_size 50m;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $synapseflow_connection_upgrade;
    proxy_read_timeout 120s;
    proxy_send_timeout 120s;

    location ~ ^/api/v1/.*/stream {
        proxy_pass http://synapseflow_test;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        add_header X-Accel-Buffering no always;
    }

    location = /mcp {
        proxy_pass http://synapseflow_test;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        add_header X-Accel-Buffering no always;
    }

    location ^~ /mcp/ {
        proxy_pass http://synapseflow_test;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        add_header X-Accel-Buffering no always;
    }

    location / {
        proxy_pass http://synapseflow_test;
    }
}
